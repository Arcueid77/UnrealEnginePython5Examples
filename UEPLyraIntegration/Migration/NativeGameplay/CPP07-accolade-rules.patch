+
+bool ULyraAccoladeHostWidget::UEPRequestAccoladeRow(FGameplayTag PayloadTag, int32 SequenceID)
+{
+	FDataRegistryId ItemID(NAME_AccoladeRegistryID, PayloadTag.GetTagName());
+	if (!UDataRegistrySubsystem::Get()->AcquireItem(ItemID, FDataRegistryItemAcquiredCallback::CreateUObject(this, &ThisClass::OnRegistryLoadCompleted, SequenceID, UEPLifetimeGeneration)))
+	{
+		UE_LOG(LogLyra, Error, TEXT("Failed to find accolade registry for tag %s, accolades will not appear"), *PayloadTag.GetTagName().ToString());
+		return false;
+	}
+	return true;
+}
+
+void ULyraAccoladeHostWidget::UEPQueueAccoladeRow_Implementation(const FLyraAccoladeDefinitionRow& Row, int32 SequenceID)
+{
+	FPendingAccoladeEntry& Entry = PendingAccoladeLoads.AddDefaulted_GetRef();
+	Entry.Row = Row;
+	Entry.SequenceID = SequenceID;
+	UEPStartAccoladeAssetLoad(SequenceID);
+}
+
+void ULyraAccoladeHostWidget::UEPStartAccoladeAssetLoad(int32 SequenceID)
+{
+	const FPendingAccoladeEntry* Entry = PendingAccoladeLoads.FindByPredicate([SequenceID](const FPendingAccoladeEntry& Candidate) { return Candidate.SequenceID == SequenceID; });
+	if (!ensure(Entry)) { return; }
+	TArray<FSoftObjectPath> AssetsToLoad;
+	AssetsToLoad.Add(Entry->Row.Sound.ToSoftObjectPath());
+	AssetsToLoad.Add(Entry->Row.Icon.ToSoftObjectPath());
+	const int32 LifetimeGeneration = UEPLifetimeGeneration;
+	AsyncLoad(AssetsToLoad, [this, SequenceID, LifetimeGeneration]
+	{
+		if (!bUEPAcceptingNotifications || LifetimeGeneration != UEPLifetimeGeneration) { return; }
+		FPendingAccoladeEntry* Finished = PendingAccoladeLoads.FindByPredicate([SequenceID](const FPendingAccoladeEntry& Candidate) { return Candidate.SequenceID == SequenceID; });
+		if (ensure(Finished))
+		{
+			Finished->Sound = Finished->Row.Sound.Get();
+			Finished->Icon = Finished->Row.Icon.Get();
+			Finished->bFinishedLoading = true;
+			ConsiderLoadedAccolades();
+		}
+	});
+	StartAsyncLoading();
+}
+
+void ULyraAccoladeHostWidget::UEPScheduleAccoladePop(float Duration)
+{
+	GetWorld()->GetTimerManager().SetTimer(NextTimeToReconsiderHandle, this, &ThisClass::PopDisplayedAccolade, Duration);
+}
+
+void ULyraAccoladeHostWidget::UEPClearAccoladeState_Implementation()
+{
+	for (const FPendingAccoladeEntry& Entry : PendingAccoladeDisplays)
+	{
+		if (UUserWidget* Widget = Entry.AllocatedWidget) { DestroyAccoladeWidget(Widget); }
+	}
+	PendingAccoladeLoads.Reset();
+	PendingAccoladeDisplays.Reset();
+	NextDisplaySequenceID = 0;
+	AllocatedSequenceID = 0;
+}
