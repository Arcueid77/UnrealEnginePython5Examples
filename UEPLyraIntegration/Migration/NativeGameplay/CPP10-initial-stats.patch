+
+TArray<FUEPInitialItemStat> UInventoryFragment_SetStats::UEPGetInitialStats() const
+{
+	TArray<FUEPInitialItemStat> Result;
+	Result.Reserve(InitialItemStats.Num());
+	for (const auto& Entry : InitialItemStats)
+	{
+		FUEPInitialItemStat& Row = Result.AddDefaulted_GetRef();
+		Row.Tag = Entry.Key;
+		Row.Count = Entry.Value;
+	}
