+FString ULyraHUDLayout::UEPGetEscapeMenuPath() const
+{
+	return ensure(!EscapeMenuClass.IsNull()) ? EscapeMenuClass.ToSoftObjectPath().ToString() : FString();
+}
+
+void ULyraHUDLayout::UEPPushEscapeMenu(TSoftClassPtr<UCommonActivatableWidget> MenuClass)
+{
+	UCommonUIExtensions::PushStreamedContentToLayer_ForPlayer(GetOwningLocalPlayer(), TAG_UI_LAYER_MENU, MenuClass);
+}
+
+int32 ULyraHUDLayout::UEPGetCurrentUIInputMode() const
+{
+	const ULocalPlayer* Player = GetOwningLocalPlayer();
+	const UCommonUIActionRouterBase* Router = Player ? Player->GetSubsystem<UCommonUIActionRouterBase>() : nullptr;
+	return Router ? static_cast<int32>(Router->GetActiveInputMode()) : -1;
+}
